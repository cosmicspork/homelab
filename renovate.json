{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":rebaseStalePrs",
    "helpers:pinGitHubActionDigests"
  ],
  "prHourlyLimit": 4,
  "flux": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)kubernetes/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*image=(?<depName>\\S+)\\s+tag:\\s+\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchPackageNames": ["immich"],
      "groupName": "immich chart"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Own images: the cooldown guards against upstream churn, which doesn't apply to self-published releases",
      "matchPackageNames": ["ghcr.io/cosmicspork/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": null,
      "automerge": true
    },
    {
      "description": "Immich holds the family photo library, and a minor release can need a matching Postgres image, so minors get a human review; patches still automerge",
      "matchPackageNames": ["ghcr.io/immich-app/**", "immich"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "BuildKit runs with Unconfined seccomp and AppArmor and must stay wire-compatible with the buildctl in the tracon-node image, so every bump gets a human review",
      "matchPackageNames": ["moby/buildkit", "docker.io/moby/buildkit"],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "enabled": false
    },
    {
      "description": "GHCR never returns release timestamps and Docker Hub stops paging long tag lists (cloudflared), so under the default timestamp-required these updates stay pending forever; they skip the cooldown instead",
      "matchDatasources": ["docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "gotk-components.yaml is generated by flux install; the flux manager bumps it through fluxcd/flux2, so per-controller image PRs would fight that",
      "matchManagers": ["kubernetes", "helm-values"],
      "matchFileNames": ["kubernetes/clusters/production/flux-system/gotk-components.yaml"],
      "enabled": false
    }
  ]
}
